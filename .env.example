# Copy this file to .env and adjust values before running `docker compose up`.

# --- Postgres ---
# IMPORTANT, and easy to get wrong: Postgres only applies this password when
# it FIRST creates its data directory. Change it later and the running
# database keeps the old one — the value here and the value in the database
# drift apart, and the backend starts failing to connect with a password
# authentication error that looks like it came out of nowhere. So set it
# before the first `docker compose up`. Changing it afterwards means either
# ALTER USER inside the running database, or deleting the aurum_pgdata volume
# (which deletes all your data — export a backup from Settings first).
#
# The database is not published to your host machine (no ports mapping for the
# db service), so it's only reachable from inside the container network.
AURUM_POSTGRES_USER=aurum
AURUM_POSTGRES_PASSWORD=change-me
AURUM_POSTGRES_DB=aurum
AURUM_POSTGRES_HOST=db
AURUM_POSTGRES_PORT=5432

# --- Backend ---
# Pullable image tags for CasaOS. Local Docker Compose still builds the source
# contexts when started with `docker compose up --build`; CasaOS pulls these
# published images because it has no checkout context for `build: ./...`.
AURUM_BACKEND_IMAGE=ghcr.io/pushkaryovvd/aurum-backend:develop
AURUM_WEB_IMAGE=ghcr.io/pushkaryovvd/aurum-web:develop

# --- Internal Docker network ---
# The defaults are compatible with existing installations. If the host already
# owns an overlapping Docker subnet, select an unused /29 and keep every IP
# below inside it. For example, 172.16.254.0/29 uses gateway .1, database .2,
# web .3, backend .4 and auth-key-init .6.
# Do not change these values during a normal update unless Docker reports an
# overlapping-network error; they are not application credentials.
AURUM_INTERNAL_SUBNET=172.31.254.0/29
AURUM_INTERNAL_GATEWAY=172.31.254.1
AURUM_DB_IP=172.31.254.2
AURUM_WEB_IP=172.31.254.3
AURUM_BACKEND_IP=172.31.254.4
AURUM_AUTH_KEY_INIT_IP=172.31.254.6
AURUM_AUTH_TRUSTED_PROXY_CIDRS=172.31.254.3/32
AURUM_AUTH_LOOPBACK_CLIENT_CIDRS=127.0.0.0/8,::1/128,172.31.254.1/32

# --- HTTPS overlay (only with docker-compose.tls.yml) ---
# A real public hostname is required for Let's Encrypt. If the internal subnet
# above is changed to avoid a host collision, select a separate unused /29 for
# this TLS network as well. For example: 172.16.255.0/29, gateway .1, Caddy .2
# and web .3.
AURUM_DOMAIN=
AURUM_TLS_SUBNET=172.31.255.0/29
AURUM_TLS_GATEWAY=172.31.255.1
AURUM_TLS_CADDY_IP=172.31.255.2
AURUM_TLS_WEB_IP=172.31.255.3

# Comma-separated list of browser origins allowed to call the API. Leave it
# empty unless you serve the frontend from a different origin than the API:
# docker compose serves both from the same nginx, and the Vite dev server
# proxies /api, so neither needs this. "*" is honoured but then credentials
# are never granted, because "*" plus credentials lets any site you visit
# read this instance.
AURUM_CORS_ORIGINS=
AURUM_DEFAULT_CURRENCY=KZT

# --- Crypto tab (live prices via CoinGecko) ---
# Free Demo API key, no card required: coingecko.com/en/api/pricing. Leave
# blank and the Crypto tab's price sync just 400s with a message telling
# you to set this — nothing else in the app is affected.
AURUM_COINGECKO_API_KEY=

# Swagger UI / ReDoc / openapi.json for explicit legacy auth-disabled mode.
# Required application authentication always suppresses these endpoints even
# when this flag is true, because exposing the API schema is not part of the
# bounded first-owner release. DOCS.md remains the static reference.
AURUM_ENABLE_DOCS=true

# The develop/test Compose enables application authentication so a fresh
# installation immediately presents the one-time first-owner ceremony. The
# installation HMAC key is generated automatically in Docker's private
# `aurum_auth_secrets` volume; do not set or copy it here. Authenticated finance
# remains fail-closed until its separate rollout is complete.
AURUM_APP_AUTH_REQUIRED=true
AURUM_ENVIRONMENT=development
AURUM_AUTH_HMAC_SECRET=
AURUM_AUTH_SESSION_IDLE_SECONDS=1800
AURUM_AUTH_SESSION_ABSOLUTE_SECONDS=604800
AURUM_AUTH_ARGON2_MEMORY_KIB=65536
AURUM_AUTH_ARGON2_TIME_COST=3
AURUM_AUTH_ARGON2_PARALLELISM=4
AURUM_AUTH_LOGIN_MAX_ATTEMPTS=5
AURUM_AUTH_LOGIN_WINDOW_SECONDS=900
AURUM_AUTH_LOGIN_BLOCK_SECONDS=900
# Automatically issued into backend logs only when application auth is enabled
# and there are no users. This is a lifetime, not a bootstrap secret.
AURUM_INITIAL_OWNER_BOOTSTRAP_TTL_SECONDS=900

# --- Basic auth (STRONGLY recommended if this instance is reachable from
# anywhere other than your own machine) ---
# Aurum now has an invite-only identity session and one-time first-owner flow,
# but required-auth finance is intentionally still blocked. Basic Auth remains
# the independent outer perimeter for the whole site, static assets and API.
# If application auth is explicitly disabled for legacy finance access, leaving
# these blank means anyone who can reach Aurum can read/edit/delete that data.
# See frontend/docker-entrypoint.d/20-basic-auth.sh.
AURUM_BASIC_AUTH_USER=
AURUM_BASIC_AUTH_PASSWORD=

# --- Ports exposed on your host machine ---
AURUM_WEB_PORT=3000

# Which host interface Aurum listens on. The default, 127.0.0.1, means "this
# machine only" — nothing else on your network can reach it. Change it to
# 0.0.0.0 to open it up (phone on the same Wi-Fi, another PC, a reverse
# proxy), but configure Basic Auth and TLS first; this line decides who can
# reach the installation before Aurum's application-level checks run.
AURUM_BIND_ADDRESS=127.0.0.1

# Hostnames Aurum will answer to, space- or comma-separated. Anything else
# gets a 421 with a message telling you to edit this line. It exists to block
# DNS rebinding: a site you're visiting can point its own domain at
# 127.0.0.1 and then read your instance through your own browser — the Host
# header is what gives it away.
#
# If you opened AURUM_BIND_ADDRESS above, add whatever you type in the
# address bar here too: the LAN IP (192.168.1.50), your domain
# (aurum.example.com), a .local name. Set it to * to turn the check off.
AURUM_ALLOWED_HOSTS=localhost 127.0.0.1
